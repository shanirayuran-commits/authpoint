# Database Configuration
# Use PostgreSQL for cloud deployments
DATABASE_URL=postgresql://user:password@host:port/database

# Node Environment
NODE_ENV=production

# Server Port (optional, defaults to 3000)
PORT=3000

# JWT Secret (optional, will auto-generate if not provided)
# JWT_SECRET=your-super-secret-key-here

# Example database URLs:

# 1. Supabase (PostgreSQL hosted)
# DATABASE_URL=postgresql://[user]:[password]@[host]:[port]/[database]

# 2. Railway.app PostgreSQL
# DATABASE_URL=postgresql://[user]:[password]@[host]:[port]/[database]

# 3. Vercel Postgres
# DATABASE_URL=postgresql://[user]:[password]@[host]:[port]/[database]

# 4. Render PostgreSQL
# DATABASE_URL=postgresql://[user]:[password]@[host]:[port]/[database]

# 5. Heroku Postgres
# DATABASE_URL=postgres://[user]:[password]@[host]:[port]/[database]

# 6. Local PostgreSQL (for development)
# DATABASE_URL=postgresql://postgres:password@localhost:5432/identitycore
